APP_ENV=local

# Use "mock" to run without API cost, or "openai" for real generation.
LLM_MODE=mock
EMBEDDING_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_NORMALIZATION_MODEL=gpt-4.1-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# "persistent" stores Chroma under backend/data/chroma.
# "http" connects to the Chroma service in docker-compose.yml.
CHROMA_MODE=persistent
CHROMA_PATH=data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_SSL=false
CHROMA_COLLECTION=destination_docs
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.15
